{
  "name": "j2w-ai-test-factory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "J2W AI Test Factory - POC (mock data for demonstration)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check:names": "node scripts/check-names.mjs",
    "build:smoke": "vite build --config vite.smoke.config.ts",
    "smoke": "npm run build:smoke && node scripts/smoke.mjs",
    "layout:audit": "node scripts/layout-audit.mjs",
    "verify": "npm run typecheck && npm run build && npm run check:names && npm run layout:audit && npm run smoke"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
